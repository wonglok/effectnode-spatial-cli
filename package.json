{
  "name": "@effectnode/spatial-cli",
  "version": "0.11.0",
  "description": "Start a full-stack media app: Vite + React + TypeScript frontend, Express backend with REST + WebSocket API",
  "license": "MIT",
  "author": "",
  "type": "module",
  "repository": {
    "url": "https://github.com/wonglok/effectnode-spatial-cli"
  },
  "bin": {
    "effectnode-spatial-cli": "./bin/effectnode-spatial-cli"
  },
  "files": [
    "dist",
    "bin",
    "frontend"
  ],
  "scripts": {
    "deploy": "npm run build; npm version minor; npm publish --access public",
    "build": "tsc",
    "dev": "open http://localhost:5288; concurrently -k -n backend,frontend -c blue,green \"bun run dev:backend\" \"bun run dev:frontend\";",
    "dev:backend": "nodemon",
    "dev:frontend": "vite",
    "start": "node bin/effectnode-spatial-cli"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.1.1",
    "@ffmpeg/core": "^0.12.10",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "@monaco-editor/loader": "^1.7.0",
    "@monaco-editor/react": "^4.7.0",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.185.4",
    "@types/ws": "^8.5.14",
    "@vitejs/plugin-react": "^4.3.4",
    "@xyflow/react": "^12.11.3",
    "chalk": "^5.4.1",
    "commander": "^13.1.0",
    "concurrently": "^10.0.5",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "localforage": "^1.10.0",
    "monaco-editor": "0.52.2",
    "mustache": "^4.2.0",
    "nodemon": "^3.1.0",
    "open": "^10.1.0",
    "openai": "^7.5.0",
    "papaparse": "^5.6.0",
    "prettier": "^3.9.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "react-router": "^8.3.0",
    "react-router-dom": "^7.18.2",
    "remark-gfm": "^4.0.1",
    "sharp": "^0.35.3",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "tailwindcss": "^4.3.3",
    "three": "^0.185.1",
    "tsx": "^4.19.0",
